# Configuration exclusivement serveur, jamais préfixer ce nom par VITE_
DATABASE_URL=postgresql://USER:PASSWORD@HOST/diaporama_singe_chatgpt?sslmode=require
# Réservé aux futures routes d'écriture et au serveur MCP, non utilisé en étape 1.
EDITOR_ACCESS_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_20_CHARACTERS

# Optionnel : identifiant public OAuth de type Application Web (aucun secret client).
# Peut aussi être saisi dans l'éditeur lors du premier export Google Slides.
# VITE_GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
